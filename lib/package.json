{
  "name": "@leadadapter/client",
  "version": "0.2.0",
  "description": "Workspace-scoped LeadAdapter REST client generated from the published OpenAPI contract",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
    "./workflows": {
      "types": "./workflows.d.ts",
      "import": "./workflows.mjs"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "requests.d.ts",
    "operations.js",
    "README.md",
    "cli.mjs",
    "workflows.mjs",
    "workflow-contract.json",
    "agentkit",
    "reports.mjs",
    "workflows.d.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "python3 generate.py"
  },
  "bin": {
    "leadadapter": "./cli.mjs"
  }
}
